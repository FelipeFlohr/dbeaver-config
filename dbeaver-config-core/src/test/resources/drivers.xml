<?xml version="1.0" encoding="UTF-8"?>
<drivers>
	<provider id="postgresql">
		<driver id="postgres-jdbc" categories="sql" name="PostgreSQL" class="org.postgresql.Driver" url="jdbc:postgresql://{host}[:{port}]/[{database}]" port="5432" defaultDatabase="postgres" defaultUser="postgres" description="PostgreSQL standard driver" custom="false">
			<library type="jar" path="maven:/org.postgresql:postgresql:RELEASE" custom="false" version="42.7.13">
				<file id="org.postgresql:postgresql:RELEASE" version="42.7.13" path="${drivers_home}/maven/maven-central/org.postgresql/postgresql-42.7.13.jar" crc="5099f19d"/>
				<file id="org.checkerframework:checker-qual:3.55.1" version="3.55.1" path="${drivers_home}/maven/maven-central/org.checkerframework/checker-qual-3.55.1.jar" crc="20b697f3"/>
			</library>
			<library type="jar" path="maven:/net.postgis:postgis-jdbc:RELEASE" custom="false" version="2.5.0" ignore-dependencies="true">
				<file id="net.postgis:postgis-jdbc:RELEASE" version="2.5.0" path="${drivers_home}/maven/maven-central/net.postgis/postgis-jdbc-2.5.0.jar" crc="5b9fcd22"/>
			</library>
			<library type="license" path="licenses/external/pg.txt" custom="false"/>
		</driver>
	</provider>
	<provider id="oracle">
		<driver id="oracle_thin" name="Oracle" class="oracle.jdbc.OracleDriver" custom="true">
			<library type="jar" path="ojdbc" custom="true">
				<file id="ojdbc-bundled" version="23.9" path="${dbeaver_home}/drivers/oracle/ojdbc11.jar" crc="1a2b3c4d"/>
				<file id="ojdbc-unknown" version="23.9" path="${unknown_home}/ojdbc11.jar" crc="5e6f7a8b"/>
			</library>
		</driver>
		<driver name="Driver without an id" class="com.example.NoIdDriver"/>
	</provider>
</drivers>
